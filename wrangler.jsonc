{
  // Untuk Cloudflare Pages (Git integration) file ini TIDAK dipakai.
  // Dashboard Pages memakai: Build command = npx @opennextjs/cloudflare build
  //                          Build output = .open-next/assets
  // File ini hanya untuk `wrangler pages dev` lokal. Jangan isi `main`/`assets` seperti Workers.
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "okesite-workspace",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"]
}
